{
    "name": "Monorepo-Nextjs-Template",
    "description": "Monorepo template for Next.js projects",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "lint": "biome lint --write",
        "format": "biome format --write",
        "check": "biome check --write",
        "dev:www": "npm run dev --workspace=@my-app/www",
        "dev:admin": "npm run dev --workspace=@my-app/admin"
    },
    "packageManager": "npm@11.19.1",
    "engines": {
        "npm": "11.19.1",
        "node": "^24.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@types/node": "^24.19.1",
        "npm": "11.19.1",
        "typescript": "^7.0.2"
    }
}
